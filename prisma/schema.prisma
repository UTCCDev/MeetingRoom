// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User model - stores employee information
model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  password  String
  role      UserRole   @default(USER)
  active    Boolean    @default(true) // false = account disabled, cannot sign in
  isPresidentApprover Boolean @default(false) // approves president rooms; ROOM_ADMIN/SYSTEM_ADMIN only
  autoApproveBooking  Boolean @default(false) // bookings by or for this user approve immediately (not president rooms)
  departmentId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  bookings  Booking[]  @relation("BookedBy")
  bookingsFor Booking[] @relation("BookedFor")
  bookingsApproved Booking[] @relation("ApprovedBy")
  roomsAsAdmin Room[] // Rooms this user administers
  serviceMembers ServiceMember[]
  serviceRequestsRequested ServiceRequest[] @relation("ServiceRequester")
  serviceRequestsCreated ServiceRequest[] @relation("ServiceCreatedBy")
  serviceRequestsAssigned ServiceRequest[] @relation("ServiceAssignee")

  @@map("users")
}

model Department {
  id    String @id @default(cuid())
  name  String @unique
  users User[]

  @@map("departments")
}

enum UserRole {
  USER
  ROOM_ADMIN
  SYSTEM_ADMIN
}

// Room model - stores meeting room information
model Room {
  id          String   @id @default(cuid())
  code        String?  @unique // e.g. M030401 = type prefix + building(2) + floor(2) + room(2), see lib/room-code.ts
  roomType    RoomType @default(MEETING)
  roomNumber  String? // room number within the floor, 2 digits in the code
  name        String
  description String?  @db.Text
  capacity    Int
  pricePerHour Int     @default(500) // Thai baht per hour, mock pricing editable later
  image       String?
  amenities   Json? // JSON array of amenities
  photos      Json? // { [shot]: url } real photos of seating, screen, whiteboard, etc.
  calendarEmail String? // Room mailbox (e.g. room_241500@utcc.ac.th) synced via Microsoft Graph on approval
  roomAdminId String
  status      Boolean  @default(true) // true = active, false = inactive
  requiresPresidentApproval Boolean @default(false) // e.g. ห้องไทรทอง, building 24 floor 8
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  roomAdmin   User     @relation(fields: [roomAdminId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@map("rooms")
}

enum RoomType {
  MEETING // M
  EVENT // E
  SEMINAR // S
}

// Booking model - stores booking information
model Booking {
  id            String        @id @default(cuid())
  userId        String
  roomId        String
  title         String
  description   String?       @db.Text
  attendees     Int
  startTime     DateTime
  endTime       DateTime
  status        BookingStatus @default(PENDING)
  rejectionReason String?
  graphEventId  String? // Microsoft Graph calendar event id in the room mailbox, set when approved
  bookedForId   String? // beneficiary when booked on someone else's behalf; null = the booker
  approvedById  String?
  autoApproved  Boolean       @default(false)
  decisionNote  String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  user          User          @relation("BookedBy", fields: [userId], references: [id], onDelete: Cascade)
  bookedFor     User?         @relation("BookedFor", fields: [bookedForId], references: [id], onDelete: SetNull)
  approvedBy    User?         @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]

  @@map("bookings")
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ServiceDepartment {
  AV
  HOUSEKEEPING
}

enum ServiceMemberRole {
  ADMIN
  STAFF
}

enum ServiceStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  DONE
  REJECTED
  CANCELLED
}

model ServiceMember {
  id         String            @id @default(cuid())
  userId     String
  department ServiceDepartment
  role       ServiceMemberRole

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, department])
  @@map("service_members")
}

model ServiceCatalogItem {
  id         String            @id @default(cuid())
  department ServiceDepartment
  name       String
  returnable Boolean           @default(false)
  active     Boolean           @default(true)
  sortOrder  Int               @default(0)

  requestItems ServiceRequestItem[]

  @@unique([department, name])
  @@map("service_catalog_items")
}

model ServiceRequest {
  id               String            @id @default(cuid())
  department       ServiceDepartment
  status           ServiceStatus     @default(PENDING)
  requesterId      String
  createdById      String // differs from requester when a dept admin files it
  bookingId        String?
  location         String? // required when bookingId is null
  startTime        DateTime // copied from booking when linked
  endTime          DateTime
  contactPhone     String
  note             String?           @db.Text
  visibleAt        DateTime? // when the department could first see it; null = hidden
  assigneeId       String?
  assignedAt       DateTime?
  coordinatorName  String?
  coordinatorPhone String?
  borrowedAt       DateTime?
  returnedAt       DateTime?
  internalNote     String?           @db.Text
  rejectionReason  String?           @db.VarChar(500)
  decidedAt        DateTime? // last status change by department (accept/reject/progress/done)
  cancelledAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  requester   User                @relation("ServiceRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  createdBy   User                @relation("ServiceCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  assignee    User?               @relation("ServiceAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  booking     Booking?            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  items       ServiceRequestItem[]
  attachments ServiceAttachment[]

  @@unique([bookingId, department])
  @@index([department, status, startTime])
  @@map("service_requests")
}

model ServiceRequestItem {
  id            String  @id @default(cuid())
  requestId     String
  catalogItemId String? // null = "อื่น ๆ"
  otherText     String?
  qty           Int

  request     ServiceRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  catalogItem ServiceCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@map("service_request_items")
}

model ServiceAttachment {
  id           String @id @default(cuid())
  requestId    String
  fileName     String // stored name: uuid.ext
  originalName String
  mime         String
  size         Int

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("service_attachments")
}
