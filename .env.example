# Copy this file to .env.local and fill in your actual values

# Database Configuration
DATABASE_URL="mysql://user:password@localhost:3306/meetingroom"

# NextAuth Configuration
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Email Configuration (Nodemailer)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="noreply@meetingroom.com"

# Registration: comma-separated email domains allowed to self-register ("*" = any)
ALLOWED_EMAIL_DOMAINS="utcc.ac.th"

# Microsoft 365 sign-in (Microsoft Entra ID app registration).
# Leave empty to hide the "เข้าสู่ระบบด้วย Microsoft 365" button.
# Redirect URI to register: <NEXTAUTH_URL>/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""
